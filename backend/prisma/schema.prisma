generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.Text
  role               String     @default("user") @db.VarChar(10)
  isActive           Boolean    @default(true) @map("is_active")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Set when an admin deletes the account (T52). The row stays for the audit history.
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)
  /// The email the account had; `email` then holds a placeholder so the address can be used again.
  deletedEmail       String?    @map("deleted_email") @db.VarChar(255)
  auditLogs          AuditLog[] @relation("AuditActor")
  targetedAuditLogs  AuditLog[] @relation("AuditTarget")

  @@map("users")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation("AuditActor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action       String   @db.VarChar(40)
  platform     String?  @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt], map: "audit_log_user_time")
  @@map("audit_log")
}
