DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/contact_export?schema=public
PORT=3000
NODE_ENV=development
COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CONNECTION_IDLE_TIMEOUT_MS=600000
# Telegram API keys from https://my.telegram.org (API development tools). Set both or neither.
# Empty means `telegram` uses the fake platform (development and tests only; production requires both).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# WhatsApp: baileys (real, the default) or fake (no phone needed; refused in production).
WHATSAPP_PLATFORM=baileys
# Optional until admin configuration is implemented.
# ADMIN_EMAIL=admin@example.com
